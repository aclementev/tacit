from _typeshed import Incomplete
from collections.abc import Callable
from ibis.common.grounds import Annotable
from typing import Any

__all__ = ['options']

class Config(Annotable):
    def get(self, key: str) -> Any: ...
    def set(self, key: str, value: Any) -> None: ...

class SQL(Config):
    fuse_selects: bool = ...
    default_limit: PosInt | None = ...
    default_dialect: str = ...

class Interactive(Config):
    max_rows: int = ...
    max_columns: int | None = ...
    max_length: int = ...
    max_string: int = ...
    max_depth: int = ...
    show_types: bool = ...

class Repr(Config):
    depth: PosInt | None = ...
    table_columns: PosInt | None = ...
    table_rows: PosInt = ...
    query_text_length: PosInt = ...
    show_types: bool = ...
    show_variables: bool = ...
    interactive: Interactive = ...

class Options(Config):
    interactive: bool = ...
    repr: Repr = ...
    verbose: bool = ...
    verbose_log: Callable | None = ...
    graphviz_repr: bool = ...
    default_backend: Any | None = ...
    sql: SQL = ...
    clickhouse: Config | None = ...
    impala: Config | None = ...
    pandas: Config | None = ...
    pyspark: Config | None = ...

options: Incomplete
