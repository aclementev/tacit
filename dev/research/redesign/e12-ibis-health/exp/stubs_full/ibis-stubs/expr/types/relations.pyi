import ibis.expr.schema as sch
import ibis.expr.types as ir
import ibis.selectors as s
import pandas as pd
import polars as pl
import pyarrow as pa
import re
import types
from _typeshed import Incomplete
from collections.abc import Callable, Iterable, Mapping, Sequence
from ibis import util
from ibis.common.deferred import Deferred
from ibis.common.selectors import Selector
from ibis.expr.datatypes import IntoDtype
from ibis.expr.operations.relations import JoinKind
from ibis.expr.schema import IntoSchema
from ibis.expr.types.core import Expr
from ibis.expr.types.generic import Value
from ibis.expr.types.groupby import GroupedTable
from ibis.expr.types.rich import FixedTextJupyterMixin
from ibis.expr.types.temporal_windows import WindowedTable
from ibis.formats.pandas import PandasData
from ibis.formats.pyarrow import PyArrowData
from ibis.selectors import IfAnyAll
from ibis.util import experimental
from rich.table import Table as RichTable
from typing import Any, Literal, NoReturn, overload

__all__ = ['Table', 'CachedTable']

class Table(Expr, FixedTextJupyterMixin):
    __array_priority__: int
    __array_ufunc__: Incomplete
    def get_name(self) -> str: ...
    def __array__(self, dtype=None): ...
    def __dataframe__(self, *, nan_as_null: bool = False, allow_copy: bool = True): ...
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...
    def __pyarrow_result__(self, table: pa.Table, /, *, schema: sch.Schema | None = None, data_mapper: type[PyArrowData] | None = None) -> pa.Table: ...
    def __pandas_result__(self, df: pd.DataFrame, /, *, schema: sch.Schema | None = None, data_mapper: type[PandasData] | None = None) -> pd.DataFrame: ...
    def __polars_result__(self, df: pl.DataFrame, /) -> Any: ...
    @experimental
    def to_pyarrow(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Table: ...
    def bind(self, *args: Any, **kwargs: Any) -> tuple[Value, ...]: ...
    def as_scalar(self) -> ir.Scalar: ...
    def as_table(self) -> Table: ...
    def __contains__(self, name: str) -> bool: ...
    def cast(self, schema: IntoSchema | None = None, /, **overrides: IntoDtype) -> Table: ...
    def try_cast(self, schema: IntoSchema | None = None, /, **overrides: IntoDtype) -> Table: ...
    def preview(self, *, max_rows: int | None = None, max_columns: int | None = None, max_length: int | None = None, max_string: int | None = None, max_depth: int | None = None, console_width: int | float | None = None) -> RichTable: ...
    @overload
    def __getitem__(self, what: str | int) -> ir.Column: ...
    @overload
    def __getitem__(self, what: slice | Sequence[str | int]) -> Table: ...
    def __len__(self) -> NoReturn: ...
    def __getattr__(self, key: str) -> ir.Column: ...
    def __dir__(self) -> list[str]: ...
    @property
    def columns(self) -> tuple[str, ...]: ...
    def schema(self) -> sch.Schema: ...
    def group_by(self, *by: str | ir.Value | Deferred | Iterable[str] | Iterable[ir.Value] | Iterable[Deferred], **key_exprs: str | ir.Value | Iterable[str] | Iterable[ir.Value]) -> GroupedTable: ...
    def rowid(self) -> ir.IntegerValue: ...
    def view(self) -> Table: ...
    def aggregate(self, metrics: ir.Scalar | Deferred | Sequence[ir.Scalar | Deferred] | None = (), /, *, by: Sequence[ir.Value] | None = (), having: Sequence[ir.BooleanValue] | None = (), **kwargs: ir.Value) -> Table: ...
    agg = aggregate
    def distinct(self, *, on: str | Iterable[str] | s.Selector | None = None, keep: Literal['first', 'last'] | None = 'first') -> Table: ...
    def sample(self, fraction: float, /, *, method: Literal['row', 'block'] = 'row', seed: int | None = None) -> Table: ...
    def limit(self, n: int | None, /, *, offset: int = 0) -> Table: ...
    def head(self, n: int = 5, /) -> Table: ...
    def order_by(self, *by: str | ir.Column | s.Selector | Deferred | Sequence[str | ir.Column | s.Selector | Deferred]) -> Table: ...
    def union(self, table: Table, /, *rest: Table, distinct: bool = False) -> Table: ...
    def intersect(self, table: Table, /, *rest: Table, distinct: bool = True) -> Table: ...
    def difference(self, table: Table, /, *rest: Table, distinct: bool = True) -> Table: ...
    def to_array(self) -> ir.Column: ...
    def mutate(self, *exprs: ir.Value | Deferred, **mutations: ir.Value | Deferred | str) -> Table: ...
    def select(self, *exprs: ir.Value | str | Iterable[ir.Value | str] | Deferred, **named_exprs: ir.Value | str | Deferred) -> Table: ...
    projection = select
    def rename(self, method: str | Callable[[str], str | None] | Literal['snake_case', 'ALL_CAPS'] | Mapping[str, str] | None = None, /, **substitutions: str) -> Table: ...
    def drop(self, *fields: str | Selector) -> Table: ...
    def filter(self, *predicates: ir.BooleanValue | bool | Sequence[ir.BooleanValue | bool] | IfAnyAll | Deferred) -> Table: ...
    def nunique(self, *, where: ir.BooleanValue | Deferred | None = None) -> ir.IntegerScalar: ...
    def count(self, *, where: ir.BooleanValue | Deferred | None = None) -> ir.IntegerScalar: ...
    def drop_null(self, subset: Sequence[str] | str | None = None, /, *, how: Literal['any', 'all'] = 'any') -> Table: ...
    def fill_null(self, replacements: ir.Scalar | Mapping[str, ir.Scalar], /) -> Table: ...
    def dropna(self, subset: Sequence[str] | str | None = None, /, *, how: Literal['any', 'all'] = 'any') -> Table: ...
    def fillna(self, replacements: ir.Scalar | Mapping[str, ir.Scalar], /) -> Table: ...
    def unpack(self, *columns: str) -> Table: ...
    def info(self) -> Table: ...
    def describe(self, *, quantile: Sequence[ir.NumericValue | float] = (0.25, 0.5, 0.75)) -> Table: ...
    def join(self, right: Table, /, predicates: str | Sequence[str | ir.BooleanColumn | Literal[True] | Literal[False] | tuple[str | ir.Column | ir.Deferred, str | ir.Column | ir.Deferred] | ir.BooleanValue] = (), *, how: JoinKind = 'inner', lname: str = '', rname: str = '{name}_right') -> Table: ...
    def asof_join(self, right: Table, /, on: str | ir.BooleanColumn, predicates: str | ir.Column | Sequence[str | ir.Column] = (), *, tolerance: str | ir.IntervalScalar | None = None, lname: str = '', rname: str = '{name}_right') -> Table: ...
    def cross_join(self, right: Table, /, *rest: Table, lname: str = '', rname: str = '{name}_right') -> Table: ...
    inner_join: Incomplete
    left_join: Incomplete
    outer_join: Incomplete
    right_join: Incomplete
    semi_join: Incomplete
    anti_join: Incomplete
    any_inner_join: Incomplete
    any_left_join: Incomplete
    def alias(self, alias: str, /) -> ir.Table: ...
    def sql(self, query: str, /, *, dialect: str | None = None) -> ir.Table: ...
    def to_pandas(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame: ...
    def cache(self) -> Table: ...
    def pivot_longer(self, col: str | s.Selector, /, *, names_to: str | Iterable[str] = 'name', names_pattern: str | re.Pattern = '(.+)', names_transform: Callable[[str], ir.Value] | Mapping[str, Callable[[str], ir.Value]] | None = None, values_to: str = 'value', values_transform: Callable[[ir.Value], ir.Value] | Deferred | None = None) -> Table: ...
    @util.experimental
    def pivot_wider(self, *, id_cols: s.Selector | None = None, names_from: str | Iterable[str] | s.Selector = 'name', names_prefix: str = '', names_sep: str = '_', names_sort: bool = False, names: Iterable[str] | None = None, values_from: str | Iterable[str] | s.Selector = 'value', values_fill: int | float | str | ir.Scalar | None = None, values_agg: str | Callable[[ir.Value], ir.Scalar] | Deferred = 'arbitrary') -> Table: ...
    def relocate(self, *columns: str | s.Selector, before: str | s.Selector | None = None, after: str | s.Selector | None = None, **kwargs: str) -> Table: ...
    def window_by(self, time_col: str | ir.Value, /) -> WindowedTable: ...
    def value_counts(self, *, name: str | None = None) -> ir.Table: ...
    def topk(self, k: int | None = None, *, name: str | None = None) -> ir.Table: ...
    def unnest(self, column, /, *, offset: str | None = None, keep_empty: bool = False) -> Table: ...

class CachedTable(Table):
    def __exit__(self, *_) -> None: ...
    def __enter__(self) -> CachedTable: ...
    def release(self) -> None: ...
