class Decimal(Numeric, Parametric):
    precision: int | None = ...
    scale: int | None = ...
    scalar = ...
    column = ...
    def __init__(self, precision: int | None = None, scale: int | None = None, **kwargs: Any) -> None: ...

class Interval(Parametric):
