import ibis.expr.datatypes as dt
from ibis.common.annotations import attribute
from ibis.common.typing import VarTuple
from ibis.expr.operations.core import Binary, Unary, Value

__all__ = ['LogicalBinary', 'Not', 'And', 'Or', 'Xor', 'Comparison', 'Equals', 'NotEquals', 'GreaterEqual', 'Greater', 'LessEqual', 'Less', 'IdenticalTo', 'Between', 'InValues', 'IfElse']

class LogicalBinary(Binary):
    left: Value[dt.Boolean]
    right: Value[dt.Boolean]
    dtype = ...

class Not(Unary):
    arg: Value[dt.Boolean]
    dtype = ...

class And(LogicalBinary): ...
class Or(LogicalBinary): ...
class Xor(LogicalBinary): ...

class Comparison(Binary):
    left: Value
    right: Value
    dtype = ...
    def __init__(self, left, right) -> None: ...

class Equals(Comparison): ...
class NotEquals(Comparison): ...
class GreaterEqual(Comparison): ...
class Greater(Comparison): ...
class LessEqual(Comparison): ...
class Less(Comparison): ...
class IdenticalTo(Comparison): ...

class Between(Value):
    arg: Value
    lower_bound: Value
    upper_bound: Value
    dtype = ...
    shape = ...
    def __init__(self, arg, lower_bound, upper_bound) -> None: ...

class InValues(Value):
    value: Value
    options: VarTuple[Value]
    dtype = ...
    @attribute
    def shape(self): ...

class IfElse(Value):
    bool_expr: Value[dt.Boolean]
    true_expr: Value
    false_null_expr: Value
    shape = ...
    @attribute
    def dtype(self): ...
