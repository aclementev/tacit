import datetime
import ibis.expr.builders as bl
import ibis.expr.datatypes as dt
import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import rich.table
import uuid
from _typeshed import Incomplete
from collections.abc import Iterable, Mapping, Sequence
from ibis.common.deferred import deferrable
from ibis.common.grounds import Singleton
from ibis.expr.types.core import Expr
from ibis.expr.types.rich import FixedTextJupyterMixin
from ibis.formats.pandas import PandasData
from ibis.formats.pyarrow import PyArrowData
from ibis.util import experimental
from public import public
from typing import Any, Literal, overload
from typing_extensions import Self

__all__ = ['Value', 'Scalar', 'Column', 'UnknownValue', 'UnknownScalar', 'UnknownColumn', 'NullValue', 'NullScalar', 'NullColumn', 'null', 'literal', 'ValueExpr', 'ScalarExpr', 'ColumnExpr', 'AnyValue', 'AnyScalar', 'AnyColumn']

class Value(Expr):
    def name(self, name: str, /) -> Self: ...
    def type(self) -> dt.DataType: ...
    def hash(self) -> ir.IntegerValue: ...
    @overload
    def cast(self, target_type: Literal['string', 'str'] | type[str], /) -> ir.StringValue: ...
    @overload
    def cast(self, target_type: Literal['int', 'uint', 'int8', 'uint8', 'int16', 'uint16', 'int32', 'uint32', 'int64', 'uint64'] | type[int], /) -> ir.IntegerValue: ...
    @overload
    def cast(self, target_type: Literal['float', 'float8', 'float16', 'float32', 'float64'] | type[float], /) -> ir.FloatingValue: ...
    @overload
    def cast(self, target_type: Literal['bool', 'boolean'] | type[bool], /) -> ir.BooleanValue: ...
    @overload
    def cast(self, target_type: Literal['date'], /) -> ir.DateValue: ...
    @overload
    def cast(self, target_type: Literal['datetime', 'timestamp'] | type[datetime.datetime], /) -> ir.TimestampValue: ...
    @overload
    def cast(self, target_type: Literal['time'], /) -> ir.TimeValue: ...
    @overload
    def cast(self, target_type: Literal['uuid'] | type[uuid.UUID], /) -> ir.UUIDValue: ...
    def try_cast(self, target_type: Any, /) -> Value: ...
    def coalesce(self, /, *args: Value) -> Value: ...
    def typeof(self) -> ir.StringValue: ...
    def fill_null(self, fill_value: Scalar, /) -> Self: ...
    def fillna(self, fill_value: Scalar, /) -> Self: ...
    def nullif(self, null_if_expr: Value, /) -> Self: ...
    def between(self, lower: Value, upper: Value) -> ir.BooleanValue: ...
    def isin(self, values: ir.ArrayValue | ir.Column | Iterable[Value], /) -> ir.BooleanValue: ...
    def notin(self, values: ir.ArrayValue | ir.Column | Iterable[Value], /) -> ir.BooleanValue: ...
    def substitute(self, value: Value | dict, replacement: Value | None = None, else_: Value | None = None) -> Value: ...
    def over(self, window=None, *, rows=None, range=None, group_by=None, order_by=None) -> Self: ...
    def isnull(self) -> ir.BooleanValue: ...
    def notnull(self) -> ir.BooleanValue: ...
    def case(self) -> bl.SimpleCaseBuilder: ...
    def cases(self, branch: tuple[Value, Value], /, *branches: tuple[Value, Value], else_: Value | None = None) -> Value: ...
    def collect(self, *, where: ir.BooleanValue | None = None, order_by: Any = None, include_null: bool = False, distinct: bool = False) -> ir.ArrayScalar: ...
    def identical_to(self, other: Value, /) -> ir.BooleanValue: ...
    def group_concat(self, sep: str = ',', where: ir.BooleanValue | None = None, order_by: Any = None) -> ir.StringScalar: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: Value) -> ir.BooleanValue: ...
    def __ne__(self, other: Value) -> ir.BooleanValue: ...
    def __ge__(self, other: Value) -> ir.BooleanValue: ...
    def __gt__(self, other: Value) -> ir.BooleanValue: ...
    def __le__(self, other: Value) -> ir.BooleanValue: ...
    def __lt__(self, other: Value) -> ir.BooleanValue: ...
    def asc(self, *, nulls_first: bool = False) -> Self: ...
    def desc(self, *, nulls_first: bool = False) -> Self: ...
    def to_pandas(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.Series | Any: ...

class Scalar(Value):
    @experimental
    def to_pyarrow(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Scalar: ...
    def __pyarrow_result__(self, table: pa.Table, *, schema: sch.Schema | None = None, data_mapper: type[PyArrowData] | None = None) -> pa.Scalar: ...
    def __pandas_result__(self, df: pd.DataFrame, *, schema: sch.Schema | None = None, data_mapper: type[PandasData] | None = None) -> Any: ...
    def __polars_result__(self, df: pl.DataFrame) -> Any: ...
    def as_scalar(self) -> Self: ...
    def as_table(self) -> ir.Table: ...
    def __deferred_repr__(self): ...

class Column(Value, FixedTextJupyterMixin):
    __array_priority__: int
    __array_ufunc__: Incomplete
    def __getitem__(self, _) -> None: ...
    def __array__(self, dtype=None): ...
    def preview(self, *, max_rows: int | None = None, max_length: int | None = None, max_string: int | None = None, max_depth: int | None = None, console_width: int | float | None = None) -> rich.table.Table: ...
    @experimental
    def to_pyarrow(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Array: ...
    def __pyarrow_result__(self, table: pa.Table, *, schema: sch.Schema | None = None, data_mapper: type[PyArrowData] | None = None) -> pa.Array | pa.ChunkedArray: ...
    def __pandas_result__(self, df: pd.DataFrame, *, schema: sch.Schema | None = None, data_mapper: type[PandasData] | None = None) -> pd.Series: ...
    def __polars_result__(self, df: pl.DataFrame) -> pl.Series: ...
    def as_scalar(self) -> Scalar: ...
    def as_table(self) -> ir.Table: ...
    def __deferred_repr__(self) -> str: ...
    def approx_nunique(self, *, where: ir.BooleanValue | None = None) -> ir.IntegerScalar: ...
    def approx_median(self, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def mode(self, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def max(self, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def min(self, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def argmax(self, key: ir.Value, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def argmin(self, key: ir.Value, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def median(self, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def quantile(self, quantile: float | ir.NumericValue | Sequence[ir.NumericValue | float], *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def nunique(self, *, where: ir.BooleanValue | None = None) -> ir.IntegerScalar: ...
    def topk(self, k: int | None = None, by: ir.Value | None = None, *, name: str | None = None) -> ir.Table: ...
    def arbitrary(self, *, where: ir.BooleanValue | None = None) -> Scalar: ...
    def count(self, *, where: ir.BooleanValue | None = None) -> ir.IntegerScalar: ...
    def value_counts(self, *, name: str | None = None) -> ir.Table: ...
    def first(self, *, where: ir.BooleanValue | None = None, order_by: Any = None, include_null: bool = False) -> Scalar: ...
    def last(self, *, where: ir.BooleanValue | None = None, order_by: Any = None, include_null: bool = False) -> Scalar: ...
    def rank(self) -> ir.IntegerColumn: ...
    def dense_rank(self) -> ir.IntegerColumn: ...
    def percent_rank(self) -> ir.FloatingColumn: ...
    def cume_dist(self) -> ir.FloatingColumn: ...
    def ntile(self, buckets: int | ir.IntegerValue, /) -> ir.IntegerColumn: ...
    def cummin(self, *, where=None, group_by=None, order_by=None) -> Column: ...
    def cummax(self, *, where=None, group_by=None, order_by=None) -> Column: ...
    def lag(self, offset: int | ir.IntegerValue | None = None, default: Value | None = None) -> Column: ...
    def lead(self, offset: int | ir.IntegerValue | None = None, default: Value | None = None) -> Column: ...
    def nth(self, n: int | ir.IntegerValue, /) -> Column: ...
    def to_list(self, **kwargs) -> list: ...

class UnknownValue(Value): ...
class UnknownScalar(Scalar): ...
class UnknownColumn(Column): ...
class NullValue(Value): ...
class NullScalar(Scalar, NullValue, Singleton): ...
class NullColumn(Column, NullValue): ...

@public
@deferrable
def null(type: dt.DataType | str | None = None, /) -> NullScalar: ...
@public
@deferrable
def literal(value: Any, type: dt.DataType | str | None = None) -> Scalar: ...

