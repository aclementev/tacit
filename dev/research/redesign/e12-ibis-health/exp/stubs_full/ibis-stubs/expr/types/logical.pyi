import ibis
import ibis.expr.types as ir
from ibis.expr.types.numeric import NumericColumn, NumericScalar, NumericValue
from typing_extensions import Self

__all__ = ['BooleanValue', 'BooleanScalar', 'BooleanColumn']

class BooleanValue(NumericValue):
    def ifelse(self, true_expr: ir.Value, false_expr: ir.Value, /) -> ir.Value: ...
    def __and__(self, other: bool | BooleanValue | ibis.Deferred) -> BooleanValue: ...
    __rand__ = __and__
    def __or__(self, other: bool | BooleanValue | ibis.Deferred) -> BooleanValue: ...
    __ror__ = __or__
    def __xor__(self, other: bool | BooleanValue | ibis.Deferred) -> BooleanValue: ...
    __rxor__ = __xor__
    def __invert__(self) -> Self: ...
    def negate(self) -> Self: ...

class BooleanScalar(NumericScalar, BooleanValue): ...

class BooleanColumn(NumericColumn, BooleanValue):
    def any(self, *, where: bool | BooleanValue | ibis.Deferred | None = None) -> BooleanScalar: ...
    def notany(self, *, where: bool | BooleanValue | ibis.Deferred | None = None) -> BooleanScalar: ...
    def all(self, *, where: bool | BooleanValue | ibis.Deferred | None = None) -> BooleanScalar: ...
    def notall(self, *, where: bool | BooleanValue | ibis.Deferred | None = None) -> BooleanScalar: ...
    def cumany(self, *, where: bool | BooleanValue | ibis.Deferred | None = None, group_by=None, order_by=None) -> BooleanColumn: ...
    def cumall(self, *, where: bool | BooleanValue | ibis.Deferred | None = None, group_by=None, order_by=None) -> BooleanColumn: ...
