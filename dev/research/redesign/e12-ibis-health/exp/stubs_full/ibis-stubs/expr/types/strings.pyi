import ibis.expr.types as ir
from collections.abc import Iterable, Sequence
from ibis.common.deferred import Deferred
from ibis.expr.types.generic import Column, Scalar, Value
from typing import Any, Literal
from typing_extensions import Self

__all__ = ['StringValue', 'StringScalar', 'StringColumn']

class StringValue(Value):
    def __getitem__(self, key: slice | int | ir.IntegerValue | Deferred) -> StringValue: ...
    def length(self) -> ir.IntegerValue: ...
    def lower(self) -> Self: ...
    def upper(self) -> Self: ...
    def reverse(self) -> Self: ...
    def ascii_str(self) -> ir.IntegerValue: ...
    def strip(self) -> Self: ...
    def lstrip(self) -> Self: ...
    def rstrip(self) -> Self: ...
    def capitalize(self) -> Self: ...
    def __contains__(self, *_: Any) -> bool: ...
    def contains(self, substr: str | StringValue | Deferred, /) -> ir.BooleanValue: ...
    def hashbytes(self, how: Literal['md5', 'sha1', 'sha256', 'sha512'] = 'sha256', /) -> ir.BinaryValue: ...
    def hexdigest(self, how: Literal['md5', 'sha1', 'sha256', 'sha512'] = 'sha256', /) -> ir.StringValue: ...
    def substr(self, start: int | ir.IntegerValue | Deferred, length: int | ir.IntegerValue | Deferred | None = None) -> StringValue: ...
    def left(self, nchars: int | ir.IntegerValue | Deferred, /) -> StringValue: ...
    def right(self, nchars: int | ir.IntegerValue | Deferred, /) -> StringValue: ...
    def repeat(self, n: int | ir.IntegerValue | Deferred, /) -> StringValue: ...
    def translate(self, from_str: StringValue, to_str: StringValue) -> StringValue: ...
    def find(self, sub: str | StringValue | Deferred, start: int | ir.IntegerValue | Deferred | None = None, end: int | ir.IntegerValue | Deferred | None = None, /) -> ir.IntegerValue: ...
    def lpad(self, width: int | ir.IntegerValue | Deferred, fillchar: str | StringValue = ' ', /) -> StringValue: ...
    def rpad(self, width: int | ir.IntegerValue | Deferred, fillchar: str | StringValue = ' ', /) -> StringValue: ...
    def find_in_set(self, str_list: Sequence[str], /) -> ir.IntegerValue: ...
    def join(self, strings: Sequence[str | StringValue | Deferred] | ir.ArrayValue | Deferred, /) -> StringValue: ...
    def startswith(self, start: str | StringValue | Deferred, /) -> ir.BooleanValue: ...
    def endswith(self, end: str | StringValue | Deferred, /) -> ir.BooleanValue: ...
    def like(self, patterns: str | StringValue | Deferred | Iterable[str | StringValue | Deferred], /) -> ir.BooleanValue: ...
    def ilike(self, patterns: str | StringValue | Deferred | Iterable[str | StringValue | Deferred], /) -> ir.BooleanValue: ...
    def re_search(self, pattern: str | StringValue | Deferred, /) -> ir.BooleanValue: ...
    rlike = re_search
    def re_extract(self, pattern: str | StringValue | Deferred, index: int | ir.IntegerValue) -> StringValue: ...
    def re_split(self, pattern: str | StringValue | Deferred, /) -> ir.ArrayValue: ...
    def re_replace(self, pattern: str | StringValue | Deferred, replacement: str | StringValue | Deferred) -> StringValue: ...
    def replace(self, pattern: str | StringValue | Deferred, replacement: str | StringValue | Deferred) -> StringValue: ...
    def as_timestamp(self, format_str: str, /) -> ir.TimestampValue: ...
    def as_date(self, format_str: str, /) -> ir.DateValue: ...
    def as_time(self, format_str: str, /) -> ir.TimeValue: ...
    def protocol(self) -> Self: ...
    def authority(self) -> Self: ...
    def userinfo(self) -> Self: ...
    def host(self) -> Self: ...
    def file(self) -> Self: ...
    def path(self) -> Self: ...
    def query(self, key: str | StringValue | Deferred | None = None, /): ...
    def fragment(self) -> Self: ...
    def split(self, delimiter: str | StringValue | Deferred, /) -> ir.ArrayValue: ...
    def concat(self, other: str | StringValue | Deferred, /, *args: str | StringValue | Deferred) -> StringValue: ...
    def __add__(self, other: str | StringValue | Deferred) -> StringValue: ...
    def __radd__(self, other: str | StringValue | Deferred) -> StringValue: ...
    def convert_base(self, from_base: int | ir.IntegerValue, to_base: int | ir.IntegerValue) -> ir.IntegerValue: ...
    def __mul__(self, n: int | ir.IntegerValue) -> StringValue: ...
    __rmul__ = __mul__
    def levenshtein(self, other: str | StringValue | Deferred, /) -> ir.IntegerValue: ...

class StringScalar(Scalar, StringValue): ...

class StringColumn(Column, StringValue):
    def __getitem__(self, key: slice | int | ir.IntegerValue | Deferred) -> StringColumn: ...
