import abc
from ibis.common.annotations import attribute
from ibis.expr.operations.core import Value
from ibis.expr.operations.relations import Relation

__all__ = ['Subquery', 'ExistsSubquery', 'ScalarSubquery', 'InSubquery']

class Subquery(Value, metaclass=abc.ABCMeta):
    rel: Relation
    @attribute
    def relations(self): ...

class ExistsSubquery(Subquery):
    dtype = ...
    shape = ...

class ScalarSubquery(Subquery):
    shape = ...
    def __init__(self, rel) -> None: ...
    @attribute
    def value(self): ...
    @attribute
    def dtype(self): ...

class InSubquery(Subquery):
    needle: Value
    dtype = ...
    shape = ...
    def __init__(self, rel, needle) -> None: ...
    @attribute
    def value(self): ...
    @attribute
    def relations(self): ...
