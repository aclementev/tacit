import ibis.expr.operations as ops
import ibis.expr.types as ir
from collections.abc import Sequence
from ibis.common.collections import FrozenOrderedDict
from ibis.common.grounds import Concrete
from ibis.expr.operations.relations import Unaliased
from typing import Literal

__all__ = ['WindowedTable']

class WindowedTable(Concrete):
    parent: ir.Table
    time_col: ops.Column
    window_type: Literal['tumble', 'hop'] | None = ...
    window_size: ir.IntervalScalar | None = ...
    window_slide: ir.IntervalScalar | None = ...
    window_offset: ir.IntervalScalar | None = ...
    groups: FrozenOrderedDict[str, Unaliased[ops.Column]] | None = ...
    metrics: FrozenOrderedDict[str, Unaliased[ops.Column]] | None = ...
    def __init__(self, time_col: ops.Column, **kwargs) -> None: ...
    def tumble(self, *, size: ir.IntervalScalar, offset: ir.IntervalScalar | None = None) -> WindowedTable: ...
    def hop(self, *, size: ir.IntervalScalar, slide: ir.IntervalScalar, offset: ir.IntervalScalar | None = None) -> WindowedTable: ...
    def aggregate(self, metrics: Sequence[ir.Scalar] | None = (), /, *, by: str | ir.Value | Sequence[str] | Sequence[ir.Value] | None = (), **kwargs: ir.Value) -> ir.Table: ...
    agg = aggregate
    def group_by(self, *by: str | ir.Value | Sequence[str] | Sequence[ir.Value]) -> WindowedTable: ...
