import ibis.expr.operations as ops
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import torch
from collections.abc import Iterator, Mapping
from ibis.backends import BaseBackend
from ibis.common.grounds import Immutable
from ibis.common.patterns import Coercible
from ibis.expr.sql import SQLString
from ibis.expr.visualize import EdgeAttributeGetter, NodeAttributeGetter
from ibis.util import experimental
from pathlib import Path
from rich.console import Console
from typing import Any, NoReturn

__all__ = ['Expr']

class Expr(Immutable, Coercible):
    def __rich_console__(self, console: Console, options): ...
    def __init__(self, arg: ops.Node) -> None: ...
    def __iter__(self) -> NoReturn: ...
    @classmethod
    def __coerce__(cls, value): ...
    def __reduce__(self): ...
    def __hash__(self): ...
    def equals(self, other, /) -> bool: ...
    def __bool__(self) -> bool: ...
    __nonzero__ = __bool__
    def get_name(self): ...
    def visualize(self, format: str = 'svg', *, label_edges: bool = False, verbose: bool = False, node_attr: Mapping[str, str] | None = None, node_attr_getter: NodeAttributeGetter | None = None, edge_attr: Mapping[str, str] | None = None, edge_attr_getter: EdgeAttributeGetter | None = None) -> None: ...
    def pipe(self, f, /, *args: Any, **kwargs: Any) -> Expr: ...
    def op(self) -> ops.Node: ...
    def get_backend(self) -> BaseBackend: ...
    def execute(self, *, limit: int | str | None = 'default', params: Mapping[ir.Value, Any] | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    def to_sql(self, dialect: str | None = None, pretty: bool = True, **kwargs) -> SQLString: ...
    def compile(self, *, limit: int | None = None, params: Mapping[ir.Value, Any] | None = None, pretty: bool = False) -> str | pl.LazyFrame: ...
    @experimental
    def to_pyarrow_batches(self, *, limit: int | str | None = None, params: Mapping[ir.Value, Any] | None = None, chunk_size: int = 1000000, **kwargs: Any) -> pa.ipc.RecordBatchReader: ...
    @experimental
    def to_pyarrow(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Table | pa.Array | pa.Scalar: ...
    @experimental
    def to_polars(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pl.DataFrame: ...
    @experimental
    def to_pandas_batches(self, *, limit: int | str | None = None, params: Mapping[ir.Value, Any] | None = None, chunk_size: int = 1000000, **kwargs: Any) -> Iterator[pd.DataFrame | pd.Series | Any]: ...
    @experimental
    def to_parquet(self, path: str | Path, /, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    def to_xlsx(self, path: str | Path, /, *, sheet: str = 'Sheet1', header: bool = False, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any): ...
    @experimental
    def to_parquet_dir(self, directory: str | Path, /, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @experimental
    def to_csv(self, path: str | Path, /, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @experimental
    def to_delta(self, path: str | Path, /, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @experimental
    def to_json(self, path: str | Path, /, **kwargs: Any) -> None: ...
    @experimental
    def to_torch(self, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> dict[str, torch.Tensor]: ...
    def unbind(self) -> ir.Table: ...
    def as_table(self) -> ir.Table: ...
    def as_scalar(self) -> ir.Scalar: ...
