import ibis
import ibis.expr.types as ir
from collections.abc import Sequence
from decimal import Decimal
from ibis.expr.types.generic import Column, Scalar, Value
from typing import Literal
from typing_extensions import Self

__all__ = ['NumericValue', 'NumericScalar', 'NumericColumn', 'IntegerValue', 'IntegerScalar', 'IntegerColumn', 'FloatingValue', 'FloatingScalar', 'FloatingColumn', 'DecimalValue', 'DecimalScalar', 'DecimalColumn']

Number = int | float | Decimal

class NumericValue(Value):
    def negate(self) -> Self: ...
    def __neg__(self) -> Self: ...
    def round(self, digits: int | IntegerValue = 0, /) -> NumericValue: ...
    def log(self, base: NumericValue | None = None, /) -> NumericValue: ...
    def clip(self, lower: Number | NumericValue | ibis.Deferred | None = None, upper: Number | NumericValue | ibis.Deferred | None = None) -> Self: ...
    def abs(self) -> Self: ...
    def ceil(self) -> DecimalValue | IntegerValue: ...
    def degrees(self) -> NumericValue: ...
    rad2deg = degrees
    def exp(self) -> NumericValue: ...
    def floor(self) -> DecimalValue | IntegerValue: ...
    def log2(self) -> NumericValue: ...
    def log10(self) -> NumericValue: ...
    def ln(self) -> NumericValue: ...
    def radians(self) -> NumericValue: ...
    deg2rad = radians
    def sign(self) -> NumericValue: ...
    def sqrt(self) -> NumericValue: ...
    def acos(self) -> NumericValue: ...
    def asin(self) -> NumericValue: ...
    def atan(self) -> NumericValue: ...
    def atan2(self, other: Number | NumericValue | ibis.Deferred, /) -> NumericValue: ...
    def cos(self) -> NumericValue: ...
    def cot(self) -> NumericValue: ...
    def sin(self) -> NumericValue: ...
    def tan(self) -> NumericValue: ...
    def __add__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    add = __add__
    radd = __add__
    __radd__ = __add__
    def __sub__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    sub = __sub__
    def __rsub__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    rsub = __rsub__
    def __mul__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    mul = __mul__
    rmul = __mul__
    __rmul__ = __mul__
    def __truediv__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    div = __truediv__
    __div__ = __truediv__
    def __rtruediv__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    rdiv = __rtruediv__
    __rdiv__ = __rtruediv__
    def __floordiv__(self, other: Number | NumericValue | ibis.Deferred) -> IntegerValue: ...
    floordiv = __floordiv__
    def __rfloordiv__(self, other: Number | NumericValue | ibis.Deferred) -> IntegerValue: ...
    rfloordiv = __rfloordiv__
    def __pow__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    pow = __pow__
    def __rpow__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    rpow = __rpow__
    def __mod__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    mod = __mod__
    def __rmod__(self, other: Number | NumericValue | ibis.Deferred) -> NumericValue: ...
    rmod = __rmod__
    def point(self, right: int | float | NumericValue | ibis.Deferred, /) -> ir.PointValue: ...

class NumericScalar(Scalar, NumericValue): ...

class NumericColumn(Column, NumericValue):
    def kurtosis(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None, how: Literal['sample', 'pop'] = 'sample') -> NumericScalar: ...
    def std(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None, how: Literal['sample', 'pop'] = 'sample') -> NumericScalar: ...
    def var(self, *, where: ir.BooleanValue | None = None, how: Literal['sample', 'pop'] = 'sample') -> NumericScalar: ...
    def corr(self, right: NumericColumn, /, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None, how: Literal['sample', 'pop'] = 'sample') -> FloatingScalar: ...
    def cov(self, right: NumericColumn, /, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None, how: Literal['sample', 'pop'] = 'sample') -> FloatingScalar: ...
    def mean(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None) -> NumericScalar: ...
    def cummean(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None, group_by=None, order_by=None) -> FloatingColumn: ...
    def sum(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None) -> NumericScalar: ...
    def cumsum(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None, group_by=None, order_by=None) -> NumericColumn: ...
    def bucket(self, buckets: Sequence[int], /, *, closed: Literal['left', 'right'] = 'left', close_extreme: bool = True, include_under: bool = False, include_over: bool = False) -> ir.IntegerColumn: ...
    def histogram(self, *, nbins: int | None = None, binwidth: float | None = None, base: float | None = None, eps: float = 1e-13) -> IntegerColumn: ...
    def approx_quantile(self, quantile: float | ir.NumericValue | Sequence[ir.NumericValue | float], /, *, where: ir.BooleanValue | None = None) -> NumericScalar: ...

class IntegerValue(NumericValue):
    def as_timestamp(self, unit: Literal['s', 'ms', 'us'], /) -> ir.TimestampValue: ...
    def as_interval(self, unit: Literal['Y', 'M', 'W', 'D', 'h', 'm', 's', 'ms', 'us', 'ns'] = 's', /) -> ir.IntervalValue: ...
    def convert_base(self, from_base: int | IntegerValue, to_base: int | IntegerValue) -> ir.StringValue: ...
    def __and__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    __rand__ = __and__
    def __or__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    __ror__ = __or__
    def __xor__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    __rxor__ = __xor__
    def __lshift__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    def __rlshift__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    def __rshift__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    def __rrshift__(self, other: int | IntegerValue | ibis.Deferred) -> IntegerValue: ...
    def __invert__(self) -> Self: ...

class IntegerScalar(NumericScalar, IntegerValue): ...

class IntegerColumn(NumericColumn, IntegerValue):
    def bit_and(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None) -> IntegerScalar: ...
    def bit_or(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None) -> IntegerScalar: ...
    def bit_xor(self, *, where: bool | ir.BooleanValue | ibis.Deferred | None = None) -> IntegerScalar: ...

class FloatingValue(NumericValue):
    def isnan(self) -> ir.BooleanValue: ...
    def isinf(self) -> ir.BooleanValue: ...

class FloatingScalar(NumericScalar, FloatingValue): ...
class FloatingColumn(NumericColumn, FloatingValue): ...
class DecimalValue(NumericValue): ...
class DecimalScalar(NumericScalar, DecimalValue): ...
class DecimalColumn(NumericColumn, DecimalValue): ...
