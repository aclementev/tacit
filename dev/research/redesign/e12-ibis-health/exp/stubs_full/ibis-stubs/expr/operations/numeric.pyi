import abc
import ibis.expr.datatypes as dt
from ibis.common.annotations import attribute
from ibis.expr.operations.core import Binary, Unary, Value

__all__ = ['NumericBinary', 'Add', 'Multiply', 'Power', 'Subtract', 'Divide', 'FloorDivide', 'Modulus', 'Negate', 'IsNan', 'IsInf', 'Abs', 'Ceil', 'Floor', 'Round', 'Clip', 'BaseConvert', 'MathUnary', 'Exp', 'Sign', 'Sqrt', 'Logarithm', 'Log', 'Ln', 'Log2', 'Log10', 'Degrees', 'Radians', 'TrigonometricUnary', 'TrigonometricBinary', 'Acos', 'Asin', 'Atan', 'Atan2', 'Cos', 'Cot', 'Sin', 'Tan', 'BitwiseNot', 'BitwiseBinary', 'BitwiseAnd', 'BitwiseOr', 'BitwiseXor', 'BitwiseLeftShift', 'BitwiseRightShift']

Integer = Value[dt.Integer]
SoftNumeric = Value[dt.Numeric | dt.Boolean]
StrictNumeric = Value[dt.Numeric]

class NumericBinary(Binary, metaclass=abc.ABCMeta):
    left: SoftNumeric
    right: SoftNumeric

class Add(NumericBinary):
    dtype = ...

class Multiply(NumericBinary):
    dtype = ...

class Power(NumericBinary):
    @property
    def dtype(self): ...

class Subtract(NumericBinary):
    dtype = ...

class Divide(NumericBinary):
    dtype = ...

class FloorDivide(Divide):
    dtype = ...

class Modulus(NumericBinary):
    dtype = ...

class Negate(Unary):
    arg: Value[dt.Numeric | dt.Interval]
    dtype = ...

class IsNan(Unary):
    arg: Value[dt.Floating]
    dtype = ...

class IsInf(Unary):
    arg: Value[dt.Floating]
    dtype = ...

class Abs(Unary):
    arg: SoftNumeric
    dtype = ...

class Ceil(Unary):
    arg: SoftNumeric
    @property
    def dtype(self): ...

class Floor(Unary):
    arg: SoftNumeric
    @property
    def dtype(self): ...

class Round(Value):
    arg: StrictNumeric
    digits: Integer
    shape = ...
    @property
    def dtype(self): ...

class Clip(Value):
    arg: StrictNumeric
    lower: StrictNumeric | None = ...
    upper: StrictNumeric | None = ...
    dtype = ...
    shape = ...

class BaseConvert(Value):
    arg: Value[dt.Integer | dt.String]
    from_base: Integer
    to_base: Integer
    dtype = ...
    shape = ...

class MathUnary(Unary):
    arg: SoftNumeric
    @attribute
    def dtype(self): ...

class ExpandingMathUnary(MathUnary):
    @attribute
    def dtype(self): ...

class Exp(ExpandingMathUnary): ...

class Sign(Unary):
    arg: SoftNumeric
    dtype = ...

class Sqrt(MathUnary): ...

class Logarithm(MathUnary):
    arg: StrictNumeric

class Log(Logarithm):
    base: StrictNumeric | None = ...

class Ln(Logarithm): ...
class Log2(Logarithm): ...
class Log10(Logarithm): ...
class Degrees(ExpandingMathUnary): ...
class Radians(MathUnary): ...
class TrigonometricUnary(MathUnary): ...

class TrigonometricBinary(Binary):
    left: SoftNumeric
    right: SoftNumeric
    dtype = ...

class Acos(TrigonometricUnary): ...
class Asin(TrigonometricUnary): ...
class Atan(TrigonometricUnary): ...
class Atan2(TrigonometricBinary): ...
class Cos(TrigonometricUnary): ...
class Cot(TrigonometricUnary): ...
class Sin(TrigonometricUnary): ...
class Tan(TrigonometricUnary): ...

class BitwiseNot(Unary):
    arg: Integer
    dtype = ...

class BitwiseBinary(Binary, metaclass=abc.ABCMeta):
    left: Integer
    right: Integer

class BitwiseAnd(BitwiseBinary):
    dtype = ...

class BitwiseOr(BitwiseBinary):
    dtype = ...

class BitwiseXor(BitwiseBinary):
    dtype = ...

class BitwiseLeftShift(BitwiseBinary):
    shape = ...
    dtype = ...

class BitwiseRightShift(BitwiseBinary):
    shape = ...
    dtype = ...
