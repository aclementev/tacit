import ibis.expr.types as ir
import pyarrow as pa
from collections.abc import Sequence
from functools import cached_property as cached_property

class IbisDataFrame:
    def __init__(self, table: ir.Table, nan_as_null: bool = False, allow_copy: bool = True, pyarrow_table: pa.Table | None = None) -> None: ...
    def num_columns(self): ...
    def column_names(self): ...
    def get_column(self, i: int) -> IbisColumn: ...
    def get_column_by_name(self, name: str) -> IbisColumn: ...
    def get_columns(self): ...
    def select_columns(self, indices: Sequence[int]) -> IbisDataFrame: ...
    def select_columns_by_name(self, names: Sequence[str]) -> IbisDataFrame: ...
    def __dataframe__(self, nan_as_null: bool = False, allow_copy: bool = True) -> IbisDataFrame: ...
    @property
    def metadata(self): ...
    def num_rows(self) -> int | None: ...
    def num_chunks(self) -> int: ...
    def get_chunks(self, n_chunks: int | None = None): ...

class IbisColumn:
    def __init__(self, df: IbisDataFrame, name: str) -> None: ...
    @property
    def dtype(self): ...
    @property
    def describe_categorical(self) -> None: ...
    def size(self): ...
    @property
    def offset(self): ...
    @property
    def describe_null(self): ...
    @property
    def null_count(self): ...
    @property
    def metadata(self): ...
    def num_chunks(self) -> int: ...
    def get_chunks(self, n_chunks: int | None = None): ...
    def get_buffers(self): ...
