import ibis.expr.datatypes as dt
import ibis.expr.operations as ops
import ibis.expr.types as ir
from _typeshed import Incomplete
from ibis import util as util
from ibis.common.annotations import annotated as annotated, attribute as attribute
from ibis.common.deferred import Deferred as Deferred, Resolver as Resolver, deferrable as deferrable
from ibis.common.exceptions import IbisInputError as IbisInputError
from ibis.common.grounds import Concrete as Concrete
from ibis.common.selectors import Selector as Selector
from ibis.common.typing import VarTuple as VarTuple
from typing import Any, Literal
from typing_extensions import Self

class Builder(Concrete): ...

class SearchedCaseBuilder(Builder):
    cases: VarTuple[Resolver | ops.Value[dt.Boolean]] = ...
    results: VarTuple[Resolver | ops.Value] = ...
    default: Resolver | ops.Value | None = ...
    def when(self, case_expr: Any, result_expr: Any) -> Self: ...
    def else_(self, result_expr: Any) -> Self: ...
    def end(self) -> ir.Value | Deferred: ...

class SimpleCaseBuilder(Builder):
    base: ops.Value
    cases: VarTuple[ops.Value] = ...
    results: VarTuple[ops.Value] = ...
    default: ops.Value | None = ...
    def when(self, case_expr: Any, result_expr: Any) -> Self: ...
    def else_(self, result_expr: Any) -> Self: ...
    def end(self) -> ir.Value: ...

RowsWindowBoundary: Incomplete
RangeWindowBoundary: Incomplete

class WindowBuilder(Builder):
    how: Literal['rows', 'range'] = ...
    start: RangeWindowBoundary | None = ...
    end: RangeWindowBoundary | None = ...
    groupings: VarTuple[str | Resolver | Selector | ops.Value] = ...
    orderings: VarTuple[str | Resolver | Selector | ops.SortKey] = ...
    @annotated
    def rows(self, start: RowsWindowBoundary | None, end: RowsWindowBoundary | None): ...
    @annotated
    def range(self, start: RangeWindowBoundary | None, end: RangeWindowBoundary | None): ...
    @annotated
    def between(self, start: RangeWindowBoundary | None, end: RangeWindowBoundary | None): ...
    def group_by(self, expr) -> Self: ...
    def order_by(self, expr) -> Self: ...
    def bind(self, table): ...

class LegacyWindowBuilder(WindowBuilder):
    def preceding_following(self, preceding, following, how=None) -> Self: ...
