import ibis.expr.datatypes as dt
import numbers
from ibis.common.annotations import attribute
from ibis.common.typing import VarTuple
from ibis.expr.operations.core import Column, Value
from typing import Literal

__all__ = ['Bucket']

class Bucket(Value):
    arg: Column[dt.Numeric | dt.Boolean]
    buckets: VarTuple[numbers.Real]
    closed: Literal['left', 'right'] = ...
    close_extreme: bool = ...
    include_under: bool = ...
    include_over: bool = ...
    shape = ...
    @attribute
    def dtype(self): ...
    def __init__(self, buckets, include_under, include_over, **kwargs) -> None: ...
    @property
    def nbuckets(self): ...
