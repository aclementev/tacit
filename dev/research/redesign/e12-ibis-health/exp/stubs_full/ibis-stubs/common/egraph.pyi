from _typeshed import Incomplete
from collections.abc import Callable as Callable, Generator, Hashable, Iterable, Iterator, Mapping
from ibis.common.bases import FrozenSlotted as Slotted
from ibis.common.graph import Node as Node
from ibis.util import promote_list as promote_list
from typing import Any, TypeVar

K = TypeVar('K', bound=Hashable)

class DisjointSet(Mapping[K, set[K]]):
    def __init__(self, data: Iterable[K] | None = None) -> None: ...
    def __contains__(self, id) -> bool: ...
    def __getitem__(self, id) -> set[K]: ...
    def __iter__(self) -> Iterator[K]: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: Incomplete
    def copy(self) -> DisjointSet: ...
    def add(self, id: K) -> K: ...
    def find(self, id: K) -> K: ...
    def union(self, id1, id2) -> bool: ...
    def connected(self, id1, id2): ...
    def verify(self) -> None: ...

class Variable(Slotted):
    name: str
    def __init__(self, name: str) -> None: ...
    def substitute(self, egraph, enode, subst): ...

class Pattern(Slotted):
    head: type
    args: tuple
    name: str | None
    def __init__(self, head, args, name=None, conditions=None) -> None: ...
    def matches_none(self): ...
    def matches_all(self): ...
    def __rshift__(self, rhs): ...
    def __rmatmul__(self, name): ...
    def flatten(self, var=None, counter=None) -> Generator[Incomplete, Incomplete]: ...
    def substitute(self, egraph, enode, subst): ...

class DynamicApplier(Slotted):
    func: Callable
    def __init__(self, func) -> None: ...
    def substitute(self, egraph, enode, subst): ...

class Rewrite(Slotted):
    matcher: Pattern
    applier: Callable | Pattern | Variable
    def __init__(self, matcher, applier) -> None: ...

class ENode(Slotted, Node):
    head: type
    args: tuple
    def __init__(self, head, args) -> None: ...
    @property
    def __argnames__(self): ...
    @property
    def __args__(self): ...
    def __lt__(self, other): ...
    @classmethod
    def from_node(cls, node: Any): ...
    def to_node(self): ...

class EGraph:
    def __init__(self) -> None: ...
    def add(self, node: Node) -> ENode: ...
    def union(self, node1: Node, node2: Node) -> ENode: ...
    def match(self, pattern: Pattern) -> dict[ENode, dict[str, Any]]: ...
    def apply(self, rewrites: list[Rewrite]) -> int: ...
    def run(self, rewrites: list[Rewrite], n: int = 10) -> bool: ...
    def extract(self, node: Node) -> Node: ...
    def equivalent(self, node1: Node, node2: Node) -> bool: ...
