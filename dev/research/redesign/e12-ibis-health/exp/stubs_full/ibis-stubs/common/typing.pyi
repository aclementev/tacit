import abc
from abc import abstractmethod
from ibis.common.bases import Abstract as Abstract
from ibis.common.caching import memoize as memoize
from typing import Any, TypeVar
from typing_extensions import Self

T = TypeVar('T')
U = TypeVar('U')
Namespace = dict[str, Any]
VarTuple = tuple[T, ...]

@memoize
def get_type_hints(obj: Any, include_extras: bool = True, include_properties: bool = False) -> dict[str, Any]: ...
@memoize
def get_type_params(obj: Any) -> dict[str, type]: ...
@memoize
def get_bound_typevars(obj: Any) -> dict[TypeVar, tuple[str, type]]: ...
def evaluate_annotations(annots: dict[str, str], module_name: str, class_name: str | None = None, best_effort: bool = False) -> dict[str, Any]: ...
def format_typehint(typ: Any) -> str: ...

class DefaultTypeVars:
    def __class_getitem__(cls, params): ...

class Sentinel(type):
    def __new__(cls, name, bases, namespace, **kwargs): ...
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...

class CoercionError(Exception): ...

class Coercible(Abstract, metaclass=abc.ABCMeta):
    @classmethod
    @abstractmethod
    def __coerce__(cls, value: Any, /, **kwargs: Any) -> Self: ...

def get_defining_frame(obj): ...
def get_defining_scope(obj, types=None): ...
