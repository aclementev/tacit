    def __init__(self, key, pat=...) -> None: ...
    def match(self, value, context): ...

class Replace(Slotted, Pattern):
    matcher: Pattern
    replacer: Resolver
    def __init__(self, matcher, replacer) -> None: ...
    def match(self, value, context): ...

def replace(matcher): ...

