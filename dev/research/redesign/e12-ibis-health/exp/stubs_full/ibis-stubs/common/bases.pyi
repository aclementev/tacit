import abc
from _typeshed import Incomplete
from abc import abstractmethod
from collections.abc import Generator, Mapping
from typing import Any
from typing_extensions import Self

class AbstractMeta(type):
    def __new__(metacls, clsname, bases, dct, **kwargs): ...
    def __call__(cls, *args, **kwargs): ...

class Abstract(metaclass=AbstractMeta):
    __create__: Incomplete

class Immutable(Abstract):
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, memo) -> Self: ...
    def __setattr__(self, name: str, _: Any) -> None: ...

class Singleton(Abstract):
    __instances__: Mapping[Any, Self]
    @classmethod
    def __create__(cls, *args, **kwargs) -> Self: ...

class Final(Abstract):
    def __init_subclass__(cls, **kwargs) -> None: ...
    @classmethod
    def __prohibit_inheritance__(cls, **kwargs) -> None: ...

class Hashable(Abstract, metaclass=abc.ABCMeta):
    @abstractmethod
    def __hash__(self) -> int: ...

class Comparable(Abstract, metaclass=abc.ABCMeta):
    __cache__: Incomplete
    @abstractmethod
    def __equals__(self, other) -> bool: ...
    def __eq__(self, other) -> bool: ...
    __hash__: Incomplete
    def __del__(self) -> None: ...

class SlottedMeta(AbstractMeta):
    def __new__(metacls, clsname, bases, dct, **kwargs): ...

class Slotted(Abstract, metaclass=SlottedMeta):
    __fields__: tuple[str, ...]
    def __init__(self, **kwargs) -> None: ...
    def __eq__(self, other) -> bool: ...
    __hash__: Incomplete
    def __rich_repr__(self) -> Generator[Incomplete]: ...

class FrozenSlotted(Slotted, Immutable, Hashable):
    __fields__: Incomplete
    __precomputed_hash__: int
    def __init__(self, **kwargs) -> None: ...
    def __hash__(self) -> int: ...
