import abc
from _typeshed import Incomplete
from abc import abstractmethod
from collections.abc import Callable, Iterable, Iterator, KeysView, Mapping, Sequence
from ibis.common.bases import Hashable as Hashable
from ibis.common.patterns import NoMatch as NoMatch, Pattern as Pattern
from ibis.util import experimental as experimental, promote_list as promote_list
from typing import Any, TypeVar
from typing_extensions import Self

N = TypeVar('N')
Finder: Incomplete
FinderLike: Incomplete
Replacer: Incomplete
ReplacerLike = Replacer | Pattern | Mapping

class Node(Hashable, metaclass=abc.ABCMeta):
    @classmethod
    def __recreate__(cls, kwargs: Any) -> Self: ...
    @property
    @abstractmethod
    def __args__(self) -> tuple[Any, ...]: ...
    @property
    @abstractmethod
    def __argnames__(self) -> tuple[str, ...]: ...
    @property
    def __children__(self) -> tuple[Node, ...]: ...
    def __rich_repr__(self): ...
    def map(self, fn: Callable, filter: Finder | None = None) -> dict[Node, Any]: ...
    @experimental
    def map_clear(self, fn: Callable, filter: Finder | None = None) -> Any: ...
    @experimental
    def map_nodes(self, fn: Callable, filter: Finder | None = None) -> Any: ...
    def find(self, finder: FinderLike, filter: FinderLike | None = None, context: dict | None = None, ordered: bool = False) -> list[Node]: ...
    @experimental
    def find_below(self, finder: FinderLike, filter: FinderLike | None = None, context: dict | None = None) -> list[Node]: ...
    @experimental
    def find_topmost(self, finder: FinderLike, context: dict | None = None) -> list[Node]: ...
    @experimental
    def replace(self, replacer: ReplacerLike, filter: FinderLike | None = None, context: dict | None = None) -> Any: ...

class Graph(dict[Node, Sequence[Node]]):
    def __init__(self, mapping=(), /, **kwargs) -> None: ...
    @classmethod
    def from_bfs(cls, root: Node, filter: FinderLike | None = None, context: dict | None = None) -> Self: ...
    @classmethod
    def from_dfs(cls, root: Node, filter: FinderLike | None = None, context: dict | None = None) -> Self: ...
    def nodes(self) -> KeysView[Node]: ...
    def invert(self) -> Self: ...
    def toposort(self) -> Self: ...

proceed: bool
halt: bool

def traverse(fn: Callable[[Node], tuple[bool | Iterable, Any]], node: Iterable[Node] | Node) -> Iterator[Any]: ...
def bfs(root: Node) -> Graph: ...
def bfs_while(root: Node, filter: Finder) -> Graph: ...
def dfs(root: Node) -> Graph: ...
def dfs_while(root: Node, filter: Finder) -> Graph: ...
