from _typeshed import Incomplete
from ibis.common.annotations import Annotation as Annotation, Argument as Argument, Attribute as Attribute, Signature as Signature
from ibis.common.bases import Abstract as Abstract, AbstractMeta as AbstractMeta, Comparable as Comparable, Final as Final, Hashable as Hashable, Immutable as Immutable, Singleton as Singleton
from ibis.common.collections import FrozenDict as FrozenDict
from ibis.common.patterns import Pattern as Pattern
from ibis.common.typing import evaluate_annotations as evaluate_annotations
from typing import Any, ClassVar
from typing_extensions import Self, dataclass_transform

class AnnotableMeta(AbstractMeta):
    def __new__(metacls, clsname, bases, dct, **kwargs): ...
    def __or__(self, other): ...

@dataclass_transform()
class Annotable(Abstract, metaclass=AnnotableMeta):
    __signature__: ClassVar[Signature]
    __attributes__: ClassVar[FrozenDict[str, Annotation]]
    __argnames__: ClassVar[tuple[str, ...]]
    __match_args__: ClassVar[tuple[str, ...]]
    @classmethod
    def __create__(cls, *args: Any, **kwargs: Any) -> Self: ...
    @classmethod
    def __recreate__(cls, kwargs: Any) -> Self: ...
    def __init__(self, **kwargs: Any) -> None: ...
    def __setattr__(self, name, value) -> None: ...
    def __eq__(self, other) -> bool: ...
    __hash__: Incomplete
    @property
    def __args__(self) -> tuple[Any, ...]: ...
    def copy(self, **overrides: Any) -> Annotable: ...

class Concrete(Immutable, Comparable, Annotable):
    def __init__(self, **kwargs: Any) -> None: ...
    def __reduce__(self): ...
    def __hash__(self) -> int: ...
    def __equals__(self, other) -> bool: ...
    @property
    def args(self): ...
    @property
    def argnames(self) -> tuple[str, ...]: ...
    def copy(self, **overrides) -> Self: ...
