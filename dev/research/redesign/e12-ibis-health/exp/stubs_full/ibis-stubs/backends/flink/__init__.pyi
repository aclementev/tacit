import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import pyarrow as pa
from _typeshed import Incomplete
from collections.abc import Mapping
from ibis import util as util
from ibis.backends import CanCreateDatabase as CanCreateDatabase, HasCurrentCatalog as HasCurrentCatalog, HasCurrentDatabase as HasCurrentDatabase, NoUrl as NoUrl, PyArrowExampleLoader as PyArrowExampleLoader, SupportsTempTables as SupportsTempTables
from ibis.backends.flink.ddl import CreateDatabase as CreateDatabase, CreateTableWithSchema as CreateTableWithSchema, DropDatabase as DropDatabase, DropTable as DropTable, DropView as DropView, InsertSelect as InsertSelect, RenameTable as RenameTable
from ibis.backends.sql import SQLBackend as SQLBackend
from ibis.backends.tests.errors import Py4JJavaError as Py4JJavaError
from ibis.expr.api import Watermark as Watermark
from ibis.expr.operations.udf import InputType as InputType
from ibis.util import gen_name as gen_name
from pathlib import Path
from pyflink.table import Table as Table, TableEnvironment as TableEnvironment
from pyflink.table.table_result import TableResult as TableResult
from typing import Any

class Backend(SupportsTempTables, SQLBackend, CanCreateDatabase, HasCurrentCatalog, HasCurrentDatabase, NoUrl, PyArrowExampleLoader):
    name: str
    compiler: Incomplete
    supports_temporary_tables: bool
    supports_python_udfs: bool
    def do_connect(self, table_env: TableEnvironment) -> None: ...
    @util.experimental
    @classmethod
    def from_connection(cls, table_env: TableEnvironment, /) -> Backend: ...
    def disconnect(self) -> None: ...
    def raw_sql(self, query: str) -> TableResult: ...
    def list_databases(self, *, like: str | None = None) -> list[str]: ...
    @property
    def current_catalog(self) -> str: ...
    @property
    def current_database(self) -> str: ...
    def create_database(self, name: str, /, *, db_properties: dict | None = None, catalog: str | None = None, force: bool = False) -> None: ...
    def drop_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    def list_tables(self, *, like: str | None = None, database: str | None = None, catalog: str | None = None, temp: bool = False) -> list[str]: ...
    def list_views(self, like: str | None = None, temp: bool = False) -> list[str]: ...
    def table(self, name: str, /, *, database: str | None = None, catalog: str | None = None) -> ir.Table: ...
    def get_schema(self, table_name: str, *, catalog: str | None = None, database: str | None = None) -> sch.Schema: ...
    @property
    def version(self) -> str: ...
    def compile(self, expr: ir.Expr, /, *, limit: str | None = None, params: Mapping[ir.Expr, Any] | None = None, pretty: bool = False, **_: Any) -> str: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    def create_table(self, name: str, /, obj: pd.DataFrame | pa.Table | ir.Table | None = None, *, schema: sch.Schema | None = None, database: str | None = None, catalog: str | None = None, tbl_properties: dict | None = None, watermark: Watermark | None = None, primary_key: str | list[str] | None = None, temp: bool = False, overwrite: bool = False) -> ir.Table: ...
    def drop_table(self, name: str, /, *, database: str | None = None, catalog: str | None = None, temp: bool = False, force: bool = False) -> None: ...
    def rename_table(self, old_name: str, new_name: str, force: bool = True) -> None: ...
    def create_view(self, name: str, /, obj: pd.DataFrame | ir.Table, *, schema: sch.Schema | None = None, database: str | None = None, catalog: str | None = None, force: bool = False, temp: bool = False, overwrite: bool = False) -> ir.Table: ...
    def drop_view(self, name: str, /, *, database: str | None = None, catalog: str | None = None, temp: bool = False, force: bool = False) -> None: ...
    def read_parquet(self, path: str | Path, /, *, schema: sch.Schema | None = None, table_name: str | None = None) -> ir.Table: ...
    def read_csv(self, path: str | Path, /, *, schema: sch.Schema | None = None, table_name: str | None = None) -> ir.Table: ...
    def read_json(self, path: str | Path, /, *, schema: sch.Schema | None = None, table_name: str | None = None) -> ir.Table: ...
    def insert(self, name: str, /, obj: pa.Table | pd.DataFrame | ir.Table | list | dict, *, database: str | None = None, catalog: str | None = None, overwrite: bool = False) -> TableResult: ...
    def to_pyarrow(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Table: ...
    def to_pyarrow_batches(self, expr: ir.Table, /, *, params: Mapping[ir.Scalar, Any] | None = None, chunk_size: int | None = None, limit: int | str | None = None, **kwargs: Any): ...
