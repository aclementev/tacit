class NatDumper(psycopg.adapt.Dumper):
    def dump(self, obj, context: Any | None = None) -> str | None: ...

class Backend(SupportsTempTables, SQLBackend, CanListCatalog, CanCreateDatabase, HasCurrentCatalog, HasCurrentDatabase, PyArrowExampleLoader):
    name: str
    compiler: Incomplete
    supports_python_udfs: bool
    supports_temporary_tables: bool
    @contextlib.contextmanager
    def begin(self) -> Generator[Incomplete]: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    @property
    def version(self): ...
    con: Incomplete
    def do_connect(self, host: str | None = None, user: str | None = None, password: str | None = None, port: int = 5432, database: str | None = None, schema: str | None = None, autocommit: bool = True, **kwargs: Any) -> None: ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: psycopg.Connection, /) -> Backend: ...
    def list_tables(self, *, like: str | None = None, database: tuple[str, str] | str | None = None) -> list[str]: ...
    def list_catalogs(self, *, like: str | None = None) -> list[str]: ...
    def list_databases(self, *, like: str | None = None, catalog: str | None = None) -> list[str]: ...
    @property
    def current_catalog(self) -> str: ...
    @property
    def current_database(self) -> str: ...
    def function(self, name: str, *, database: str | None = None) -> Callable: ...
    def get_schema(self, name: str, *, catalog: str | None = None, database: str | None = None): ...
    def create_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    def drop_database(self, name: str, /, *, catalog: str | None = None, force: bool = False, cascade: bool = False) -> None: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pl.DataFrame | pl.LazyFrame | None = None, *, schema: sch.IntoSchema | None = None, database: str | None = None, temp: bool = False, overwrite: bool = False): ...
    def drop_table(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    def raw_sql(self, query: str | sg.Expression, **kwargs: Any) -> Any: ...
    @util.experimental
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **_: Any) -> pa.ipc.RecordBatchReader: ...
