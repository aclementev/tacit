class _Settings:
    con: Incomplete
    def __init__(self, con: duckdb.DuckDBPyConnection) -> None: ...
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key, value) -> None: ...

class Backend(SupportsTempTables, SQLBackend, CanListCatalog, CanCreateDatabase, HasCurrentCatalog, HasCurrentDatabase, UrlFromPath, DirectExampleLoader):
    name: str
    compiler: Incomplete
    supports_temporary_tables: bool
    @property
    def settings(self) -> _Settings: ...
    @property
    def current_catalog(self) -> str: ...
    @property
    def current_database(self) -> str: ...
    def raw_sql(self, query: str | sg.Expression, **kwargs: Any) -> Any: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pl.DataFrame | pl.LazyFrame | None = None, *, schema: IntoSchema | None = None, database: str | None = None, temp: bool = False, overwrite: bool = False): ...
    def table(self, name: str, /, *, database: str | tuple[str, str] | None = None) -> ir.Table: ...
    def get_schema(self, table_name: str, *, catalog: str | None = None, database: str | None = None) -> sch.Schema: ...
    def list_catalogs(self, *, like: str | None = None) -> list[str]: ...
    def list_databases(self, *, like: str | None = None, catalog: str | None = None) -> list[str]: ...
    @property
    def version(self) -> str: ...
    con: Incomplete
    def do_connect(self, database: str | Path = ':memory:', read_only: bool = False, extensions: Sequence[str] | None = None, **config: Any) -> None: ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: duckdb.DuckDBPyConnection, /, *, extensions: Sequence[str] | None = None) -> Backend: ...
    def load_extension(self, extension: str, force_install: bool = False) -> None: ...
    def create_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    def drop_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    @util.experimental
    def read_json(self, paths: str | list[str] | tuple[str], /, *, table_name: str | None = None, columns: Mapping[str, str] | None = None, **kwargs) -> ir.Table: ...
    def read_csv(self, paths: str | list[str] | tuple[str], /, *, table_name: str | None = None, columns: Mapping[str, str | dt.DataType] | None = None, types: Mapping[str, str | dt.DataType] | None = None, **kwargs: Any) -> ir.Table: ...
    def read_geo(self, path: str, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_parquet(self, paths: str | Path | Iterable[str | Path], /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_delta(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def list_tables(self, *, like: str | None = None, database: tuple[str, str] | str | None = None) -> list[str]: ...
    def read_postgres(self, uri: str, /, *, table_name: str | None = None, database: str = 'public') -> ir.Table: ...
    def read_mysql(self, uri: str, /, *, catalog: str, table_name: str | None = None) -> ir.Table: ...
    def read_sqlite(self, path: str | Path, /, *, table_name: str | None = None) -> ir.Table: ...
    @util.experimental
    def read_xlsx(self, path: str | Path, /, *, sheet: str | None = None, range: str | None = None, **kwargs) -> ir.Table: ...
    def to_xlsx(self, expr: ir.Table, /, path: str | Path, *, sheet: str = 'Sheet1', header: bool = False, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any): ...
    def attach(self, path: str | Path, name: str | None = None, read_only: bool = False) -> None: ...
    def detach(self, name: str) -> None: ...
    def attach_sqlite(self, path: str | Path, overwrite: bool = False, all_varchar: bool = False) -> None: ...
    def register_filesystem(self, filesystem: AbstractFileSystem): ...
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **_: Any) -> pa.ipc.RecordBatchReader: ...
    def to_pyarrow(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Table: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    @util.experimental
    def to_torch(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> dict[str, torch.Tensor]: ...
    @util.experimental
    def to_parquet(self, expr: ir.Table, /, path: str | Path, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @util.experimental
    def to_csv(self, expr: ir.Table, /, path: str | Path, *, params: Mapping[ir.Scalar, Any] | None = None, header: bool = True, **kwargs: Any) -> None: ...
    @util.experimental
    def to_geo(self, expr: ir.Table, /, path: str | Path, *, format: str, layer_creation_options: Mapping[str, Any] | None = None, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> None: ...
    @util.experimental
    def to_json(self, expr: ir.Table, /, path: str | Path, *, compression: Literal['auto', 'none', 'gzip', 'zstd'] = 'auto', dateformat: str | None = None, timestampformat: str | None = None) -> None: ...
