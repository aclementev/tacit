from typing import Any, Literal

__all__ = ['aggregate_function', 'scalar_function', 'wrap_uda', 'wrap_udf', 'Backend']

class Backend(SQLBackend, HasCurrentDatabase, NoExampleLoader):
    name: str
    compiler: Incomplete
    con: Incomplete
    def do_connect(self, host: str = 'localhost', port: int = 21050, database: str = 'default', timeout: int = 45, use_ssl: bool = False, ca_cert: str | Path | None = None, user: str | None = None, password: str | None = None, auth_mechanism: Literal['NOSASL', 'PLAIN', 'GSSAPI', 'LDAP'] = 'NOSASL', kerberos_service_name: str = 'impala', **params: Any): ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: hs2.HiveServer2Connection, /) -> Backend: ...
    @cached_property
    def version(self): ...
    def list_databases(self, *, like: str | None = None) -> list[str]: ...
