    def parquet_file(self, directory: str | Path, schema: sch.Schema | None = None, name: str | None = None, database: str | None = None, external: bool = True, like_file: str | Path | None = None, like_table: str | None = None) -> ir.Table: ...
    def insert(self, name, /, obj=None, *, database=None, overwrite: bool = False, partition=None, validate: bool = True) -> None: ...
    def drop_table(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    def truncate_table(self, name: str, /, *, database: str | None = None) -> None: ...
    def rename_table(self, old_name: str, new_name: str) -> None: ...
    def drop_table_or_view(self, name, /, *, database: str | None = None, force: bool = False): ...
    def cache_table(self, table_name, *, database=None, pool: str = 'default') -> None: ...
    def create_function(self, func, name=None, database=None) -> None: ...
    def drop_udf(self, name, input_types=None, database=None, force: bool = False, aggregate: bool = False) -> None: ...
    def drop_uda(self, name, input_types=None, database=None, force: bool = False): ...
    def list_udfs(self, database=None, like=None): ...
    def list_udas(self, database=None, like=None): ...
    def exists_udf(self, name: str, database: str | None = None) -> bool: ...
    def exists_uda(self, name: str, database: str | None = None) -> bool: ...
    def compute_stats(self, name: str, database: str | None = None, incremental: bool = False) -> None: ...
    def invalidate_metadata(self, name: str | None = None, database: str | None = None) -> None: ...
    def refresh(self, name: str, database: str | None = None) -> None: ...
    def describe_formatted(self, name: str, database: str | None = None) -> pd.DataFrame: ...
    def show_files(self, name: str, database: str | None = None) -> pd.DataFrame: ...
    def list_partitions(self, name, database=None): ...
    def get_partition_schema(self, table_name: str, database: str | None = None) -> sch.Schema: ...
