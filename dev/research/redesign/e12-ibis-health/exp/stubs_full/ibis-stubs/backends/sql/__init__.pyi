import abc
import ibis.expr.operations as ops
import ibis.expr.types as ir
import pandas as pd
import pyarrow as pa
import sqlglot as sg
from collections.abc import Callable as Callable, Mapping
from ibis import util as util
from ibis.backends import BaseBackend as BaseBackend
from ibis.backends.sql.compilers.base import SQLGlotCompiler as SQLGlotCompiler
from ibis.expr.schema import IntoSchema as IntoSchema
from typing import Any, ClassVar

class SQLBackend(BaseBackend, metaclass=abc.ABCMeta):
    compiler: ClassVar[SQLGlotCompiler]
    name: ClassVar[str]
    @property
    def dialect(self) -> sg.Dialect: ...
    @classmethod
    def has_operation(cls, operation: type[ops.Value], /) -> bool: ...
    def table(self, name: str, /, *, database: tuple[str, str] | str | None = None) -> ir.Table: ...
    def compile(self, expr: ir.Expr, /, *, limit: int | None = None, params: Mapping[ir.Expr, Any] | None = None, pretty: bool = False) -> str: ...
    def sql(self, query: str, /, *, schema: IntoSchema | None = None, dialect: str | None = None) -> ir.Table: ...
    def create_view(self, name: str, /, obj: ir.Table, *, database: str | None = None, overwrite: bool = False) -> ir.Table: ...
    def drop_view(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    def drop_table(self, name: str, /, *, database: tuple[str, str] | str | None = None, force: bool = False) -> None: ...
    @util.experimental
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **_: Any) -> pa.ipc.RecordBatchReader: ...
    def insert(self, name: str, /, obj: pd.DataFrame | ir.Table | list | dict, *, database: str | None = None, overwrite: bool = False) -> None: ...
    def upsert(self, name: str, /, obj: pd.DataFrame | ir.Table | list | dict, on: str, *, database: str | None = None) -> None: ...
    def truncate_table(self, name: str, /, *, database: str | tuple[str, str] | None = None) -> None: ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: Any, /, **kwargs: Any) -> BaseBackend: ...
    def disconnect(self) -> None: ...
