class Backend(SQLBackend, CanCreateCatalog, CanCreateDatabase, HasCurrentCatalog, HasCurrentDatabase, PyArrowExampleLoader):
    name: str
    compiler: Incomplete
    supports_create_or_replace: bool
    @property
    def version(self) -> str: ...
    con: Incomplete
    def do_connect(self, host: str = 'localhost', user: str | None = None, password: str | None = None, port: int = 1433, database: str | None = None, driver: str | None = None, **kwargs: Any) -> None: ...
