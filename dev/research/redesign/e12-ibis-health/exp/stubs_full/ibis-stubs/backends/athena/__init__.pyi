import contextlib
import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import sqlglot as sg
from _typeshed import Incomplete
from collections.abc import Callable as Callable, Generator, Mapping
from ibis import util as util
from ibis.backends import CanCreateDatabase as CanCreateDatabase, NoExampleLoader as NoExampleLoader, UrlFromPath as UrlFromPath
from ibis.backends.sql import SQLBackend as SQLBackend
from ibis.backends.sql.compilers.base import AlterTable as AlterTable, RenameTable as RenameTable
from pyathena.cursor import Cursor as Cursor
from typing import Any

class Backend(SQLBackend, CanCreateDatabase, UrlFromPath, NoExampleLoader):
    name: str
    compiler: Incomplete
    @property
    def current_catalog(self) -> str: ...
    @property
    def current_database(self) -> str: ...
    def raw_sql(self, query: str | sg.Expression, **kwargs: Any) -> Any: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pl.DataFrame | pl.LazyFrame | None = None, *, schema: sch.IntoSchema | None = None, database: str | None = None, temp: bool = False, overwrite: bool | None = None, comment: str | None = None, properties: Mapping[str, Any] | None = None, location: str | None = None, stored_as: str = 'PARQUET', partitioned_by: sch.IntoSchema = ()) -> ir.Table: ...
    def table(self, name: str, /, *, database: str | None = None) -> ir.Table: ...
    def get_schema(self, table_name: str, *, catalog: str | None = None, database: str | None = None) -> sch.Schema: ...
    def list_catalogs(self, *, like: str | None = None) -> list[str]: ...
    def list_databases(self, like: str | None = None, catalog: str | None = None) -> list[str]: ...
    @property
    def version(self) -> str: ...
    con: Incomplete
    def do_connect(self, *, s3_staging_dir: str, cursor_class: type[Cursor] = ..., memtable_volume: str | None = None, schema_name: str = 'default', catalog_name: str = 'awsdatacatalog', **config: Any) -> None: ...
    @contextlib.contextmanager
    def begin(self) -> Generator[Incomplete]: ...
    @util.experimental
    @classmethod
    def from_connection(cls, con, /, *, memtable_volume: str | None = None) -> Backend: ...
    def create_database(self, name: str, /, *, location: str | None = None, catalog: str | None = None, force: bool = False) -> None: ...
    def drop_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    def list_tables(self, *, like: str | None = None, database: tuple[str, str] | str | None = None) -> list[str]: ...
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **_: Any) -> pa.ipc.RecordBatchReader: ...
    def to_pyarrow(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Table: ...
    def rename_table(self, old_name: str, new_name: str) -> None: ...
