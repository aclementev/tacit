import contextlib
import ibis.expr.datatypes as dt
import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import sqlglot as sg
import sqlite3
from _typeshed import Incomplete
from collections.abc import Generator, Mapping
from ibis import util as util
from ibis.backends import HasCurrentDatabase as HasCurrentDatabase, PyArrowExampleLoader as PyArrowExampleLoader, SupportsTempTables as SupportsTempTables, UrlFromPath as UrlFromPath
from ibis.backends.sql import SQLBackend as SQLBackend
from ibis.backends.sql.compilers.base import C as C
from ibis.backends.sqlite.converter import SQLitePandasData as SQLitePandasData
from ibis.backends.sqlite.udf import ignore_nulls as ignore_nulls, register_all as register_all
from pathlib import Path
from typing import Any

class Backend(SupportsTempTables, SQLBackend, UrlFromPath, PyArrowExampleLoader, HasCurrentDatabase):
    name: str
    compiler: Incomplete
    supports_python_udfs: bool
    @property
    def current_database(self) -> str: ...
    @property
    def version(self) -> str: ...
    con: Incomplete
    def do_connect(self, database: str | Path | None = None, type_map: dict[str, str | dt.DataType] | None = None) -> None: ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: sqlite3.Connection, /, *, type_map: dict[str, str | dt.DataType] | None = None) -> Backend: ...
    def raw_sql(self, query: str | sg.Expression, **kwargs: Any) -> Any: ...
    @contextlib.contextmanager
    def begin(self) -> Generator[Incomplete]: ...
    def list_databases(self, *, like: str | None = None) -> list[str]: ...
    def list_tables(self, *, like: str | None = None, database: str | None = None) -> list[str]: ...
    def get_schema(self, table_name: str, *, catalog: str | None = None, database: str | None = None) -> sch.Schema: ...
    @util.experimental
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **_: Any) -> pa.ipc.RecordBatchReader: ...
    def attach(self, name: str, path: str | Path) -> None: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pl.DataFrame | pl.LazyFrame | None = None, *, schema: sch.IntoSchema | None = None, database: str | None = None, temp: bool = False, overwrite: bool = False): ...
    def drop_table(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    def create_view(self, name: str, /, obj: ir.Table, *, database: str | None = None, overwrite: bool = False) -> ir.Table: ...
    def insert(self, name: str, /, obj: pd.DataFrame | ir.Table | list | dict, *, database: str | None = None, overwrite: bool = False) -> None: ...
