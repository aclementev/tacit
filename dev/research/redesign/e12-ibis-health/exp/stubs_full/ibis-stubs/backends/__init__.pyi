import abc
import collections.abc
import functools
import ibis
import ibis.expr.operations as ops
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import sqlglot as sg
import torch
import weakref
from _typeshed import Incomplete
from collections.abc import Generator, Iterator, Mapping
from ibis import util
from pathlib import Path
from typing import Any, ClassVar, NamedTuple, overload

__all__ = ['BaseBackend', 'connect']

class TablesAccessor(collections.abc.Mapping):
    def __init__(self, backend: BaseBackend) -> None: ...
    def __getitem__(self, name: str) -> ir.Table: ...
    def __getattr__(self, name: str) -> ir.Table: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def __dir__(self) -> list[str]: ...

class _FileIOHandler:
    def to_pandas(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    def to_pandas_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **kwargs: Any) -> Iterator[pd.DataFrame | pd.Series | Any]: ...
    @overload
    def to_pyarrow(self, expr: ir.Table, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Table: ...
    @overload
    def to_pyarrow(self, expr: ir.Column, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Array: ...
    @overload
    def to_pyarrow(self, expr: ir.Scalar, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pa.Scalar: ...
    @util.experimental
    def to_polars(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pl.DataFrame: ...
    @util.experimental
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **kwargs: Any) -> pa.ipc.RecordBatchReader: ...
    @util.experimental
    def to_torch(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> dict[str, torch.Tensor]: ...
    def read_parquet(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_csv(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_json(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_delta(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any): ...
    @util.experimental
    def to_parquet(self, expr: ir.Table, /, path: str | Path, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @util.experimental
    def to_parquet_dir(self, expr: ir.Table, /, directory: str | Path, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @util.experimental
    def to_csv(self, expr: ir.Table, /, path: str | Path, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @util.experimental
    def to_delta(self, expr: ir.Table, /, path: str | Path, *, params: Mapping[ir.Scalar, Any] | None = None, **kwargs: Any) -> None: ...
    @util.experimental
    def to_json(self, expr: ir.Table, /, path: str | Path, **kwargs: Any) -> None: ...

class HasCurrentCatalog(abc.ABC, metaclass=abc.ABCMeta):
    @property
    @abc.abstractmethod
    def current_catalog(self) -> str: ...

class HasCurrentDatabase(abc.ABC, metaclass=abc.ABCMeta):
    @property
    @abc.abstractmethod
    def current_database(self) -> str: ...

class CanListCatalog(abc.ABC, metaclass=abc.ABCMeta):
    @abc.abstractmethod
    def list_catalogs(self, *, like: str | None = None) -> list[str]: ...

class CanCreateCatalog(CanListCatalog, metaclass=abc.ABCMeta):
    @abc.abstractmethod
    def create_catalog(self, name: str, /, *, force: bool = False) -> None: ...
    @abc.abstractmethod
    def drop_catalog(self, name: str, /, *, force: bool = False) -> None: ...

class CanListDatabase(abc.ABC, metaclass=abc.ABCMeta):
    @abc.abstractmethod
    def list_databases(self, *, like: str | None = None, catalog: str | None = None) -> list[str]: ...

class CanCreateDatabase(CanListDatabase, metaclass=abc.ABCMeta):
    @abc.abstractmethod
    def create_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    @abc.abstractmethod
    def drop_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...

class CacheEntry(NamedTuple):
    orig_op: ops.Relation
    cached_op_ref: weakref.ref[ops.Relation]
    finalizer: weakref.finalize

class CacheHandler:
    def __init__(self) -> None: ...

class BaseBackend(abc.ABC, _FileIOHandler, CacheHandler, metaclass=abc.ABCMeta):
    name: ClassVar[str]
    supports_temporary_tables: bool
    supports_python_udfs: bool
    def __init__(self, *args, **kwargs) -> None: ...
    @property
    @abc.abstractmethod
    def dialect(self) -> sg.Dialect | None: ...
    def __rich_repr__(self) -> Generator[Incomplete]: ...
    def __hash__(self): ...
    def __eq__(self, other): ...
    @functools.cached_property
    def db_identity(self) -> str: ...
    def connect(self, *args, **kwargs) -> BaseBackend: ...
    @abc.abstractmethod
    def disconnect(self) -> None: ...
    def reconnect(self) -> None: ...
    def do_connect(self, *args, **kwargs) -> None: ...
    @abc.abstractmethod
    def list_tables(self, *, like: str | None = None, database: tuple[str, str] | str | None = None) -> list[str]: ...
    @abc.abstractmethod
    def table(self, name: str, /, *, database: tuple[str, str] | str | None = None) -> ir.Table: ...
    @property
    def tables(self): ...
    @property
    @abc.abstractmethod
    def version(self) -> str: ...
    @classmethod
    def register_options(cls) -> None: ...
    @abc.abstractmethod
    def compile(self, expr: ir.Expr, /, *, limit: int | None = None, params: Mapping[ir.Expr, Any] | None = None, **kwargs: Any) -> str | pl.LazyFrame: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    @abc.abstractmethod
    def create_table(self, name: str, /, obj: pd.DataFrame | pa.Table | ir.Table | None = None, *, schema: ibis.Schema | None = None, database: str | None = None, temp: bool = False, overwrite: bool = False) -> ir.Table: ...
    @abc.abstractmethod
    def drop_table(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    def rename_table(self, old_name: str, new_name: str) -> None: ...
    @abc.abstractmethod
    def create_view(self, name: str, /, obj: ir.Table, *, database: str | None = None, overwrite: bool = False) -> ir.Table: ...
    @abc.abstractmethod
    def drop_view(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    @classmethod
    def has_operation(cls, operation: type[ops.Value], /) -> bool: ...

class BaseExampleLoader(abc.ABC, metaclass=abc.ABCMeta): ...
class ExampleLoader(BaseExampleLoader, metaclass=abc.ABCMeta): ...
class NoExampleLoader(BaseExampleLoader): ...
class DirectExampleLoader(ExampleLoader): ...

class DirectPyArrowExampleLoader(DirectExampleLoader):
    overwrite_example: bool
    temporary_example: bool

class PyArrowExampleLoader(ExampleLoader):
    overwrite_example: bool
    temporary_example: bool

def connect(resource: Path | str, /, **kwargs: Any) -> BaseBackend: ...

class UrlFromPath: ...

class NoUrl:
    name: str

class SupportsTempTables:
    supports_temporary_tables: bool
