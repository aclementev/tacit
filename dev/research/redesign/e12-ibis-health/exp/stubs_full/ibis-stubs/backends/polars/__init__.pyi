import ibis.expr.operations as ops
import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
from collections.abc import Iterable, Mapping
from ibis.backends import BaseBackend as BaseBackend, DirectExampleLoader as DirectExampleLoader, NoUrl as NoUrl, SupportsTempTables as SupportsTempTables
from ibis.backends.polars.compiler import translate as translate
from ibis.backends.polars.rewrites import bind_unbound_table as bind_unbound_table, rewrite_join as rewrite_join
from ibis.backends.sql.dialects import Polars as Polars
from ibis.common.dispatch import lazy_singledispatch as lazy_singledispatch
from ibis.expr.rewrites import lower_stringslice as lower_stringslice, replace_parameter as replace_parameter
from ibis.formats.polars import PolarsSchema as PolarsSchema
from ibis.util import gen_name as gen_name, normalize_filename as normalize_filename, normalize_filenames as normalize_filenames
from pathlib import Path
from typing import Any, Literal

class Backend(SupportsTempTables, BaseBackend, NoUrl, DirectExampleLoader):
    name: str
    dialect = Polars
    supports_temporary_tables: bool
    def __init__(self, *args, **kwargs) -> None: ...
    def do_connect(self, tables: Mapping[str, pl.LazyFrame | pl.DataFrame] | None = None) -> None: ...
    def disconnect(self) -> None: ...
    @property
    def version(self) -> str: ...
    def list_tables(self, *, like: str | None = None, database: str | None = None) -> list[str]: ...
    def table(self, name: str, /, *, database: None = None) -> ir.Table: ...
    def sql(self, query: str, /, *, schema: sch.Schema | None = None, dialect: str | None = None) -> ir.Table: ...
    def read_csv(self, path: str | Path | list[str | Path] | tuple[str | Path], /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_json(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_delta(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_pandas(self, source: pd.DataFrame, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def read_parquet(self, path: str | Path | Iterable[str | Path], /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pa.RecordBatchReader | pa.RecordBatch | pl.DataFrame | pl.LazyFrame | None = None, *, schema: sch.IntoSchema | None = None, database: str | None = None, temp: bool | None = None, overwrite: bool = False) -> ir.Table: ...
    def create_view(self, name: str, /, obj: ir.Table, *, database: str | None = None, overwrite: bool = False) -> ir.Table: ...
    def drop_table(self, name: str, /, *, force: bool = False) -> None: ...
    def drop_view(self, name: str, /, *, force: bool = False) -> None: ...
    def get_schema(self, table_name): ...
    @classmethod
    def has_operation(cls, operation: type[ops.Value], /) -> bool: ...
    def compile(self, expr: ir.Expr, /, *, limit: str | None = None, params: Mapping[ir.Expr, Any] | None = None, **_: Any) -> pl.LazyFrame: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Expr, object] | None = None, limit: int | None = None, engine: Literal['cpu', 'gpu', 'streaming'] | pl.GPUEngine = 'cpu', **kwargs: Any): ...
    def to_polars(self, expr: ir.Expr, /, *, params: Mapping[ir.Expr, object] | None = None, limit: int | None = None, engine: Literal['cpu', 'gpu', 'streaming'] | pl.GPUEngine = 'cpu', **kwargs: Any): ...
    def to_pyarrow(self, expr: ir.Expr, /, *, params: Mapping[ir.Expr, object] | None = None, limit: int | None = None, **kwargs: Any): ...
    def to_pyarrow_batches(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, chunk_size: int = 1000000, **kwargs: Any): ...
