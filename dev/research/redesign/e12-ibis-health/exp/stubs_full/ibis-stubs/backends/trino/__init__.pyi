import contextlib
import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import sqlglot as sg
import trino
from _typeshed import Incomplete
from collections.abc import Generator, Mapping
from functools import cached_property as cached_property
from ibis import util as util
from ibis.backends import CanCreateDatabase as CanCreateDatabase, CanListCatalog as CanListCatalog, HasCurrentCatalog as HasCurrentCatalog, HasCurrentDatabase as HasCurrentDatabase, NoExampleLoader as NoExampleLoader
from ibis.backends.sql import SQLBackend as SQLBackend
from ibis.backends.sql.compilers.base import AlterTable as AlterTable, C as C, RenameTable as RenameTable
from typing import Any
from urllib.parse import ParseResult as ParseResult

class Backend(SQLBackend, CanListCatalog, CanCreateDatabase, HasCurrentCatalog, HasCurrentDatabase, NoExampleLoader):
    name: str
    compiler: Incomplete
    supports_create_or_replace: bool
    def raw_sql(self, query: str | sg.Expression) -> Any: ...
    @contextlib.contextmanager
    def begin(self) -> Generator[Incomplete]: ...
    def get_schema(self, table_name: str, *, catalog: str | None = None, database: str | None = None) -> sch.Schema: ...
    @cached_property
    def version(self) -> str: ...
    @property
    def current_catalog(self) -> str: ...
    @property
    def current_database(self) -> str: ...
    def list_catalogs(self, *, like: str | None = None) -> list[str]: ...
    def list_databases(self, *, like: str | None = None, catalog: str | None = None) -> list[str]: ...
    def list_tables(self, *, like: str | None = None, database: tuple[str, str] | str | None = None) -> list[str]: ...
    con: Incomplete
    def do_connect(self, user: str = 'user', auth: str | None = None, host: str = 'localhost', port: int = 8080, database: str | None = None, schema: str | None = None, source: str | None = None, timezone: str = 'UTC', **kwargs) -> None: ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: trino.dbapi.Connection, /) -> Backend: ...
    def create_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    def drop_database(self, name: str, /, *, catalog: str | None = None, force: bool = False) -> None: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pl.DataFrame | pl.LazyFrame | None = None, *, schema: sch.IntoSchema | None = None, database: str | None = None, temp: bool = False, overwrite: bool = False, comment: str | None = None, properties: Mapping[str, Any] | None = None) -> ir.Table: ...
