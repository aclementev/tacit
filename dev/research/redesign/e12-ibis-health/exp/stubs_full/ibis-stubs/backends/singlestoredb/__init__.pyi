import contextlib
import ibis.expr.schema as sch
import ibis.expr.types as ir
import pandas as pd
import polars as pl
import pyarrow as pa
import sqlglot as sg
from collections.abc import Generator, Mapping
from ibis import util as util
from ibis.backends import CanCreateDatabase as CanCreateDatabase, HasCurrentDatabase as HasCurrentDatabase, PyArrowExampleLoader as PyArrowExampleLoader, SupportsTempTables as SupportsTempTables
from ibis.backends.sql import SQLBackend as SQLBackend
from ibis.backends.sql.compilers.singlestoredb import compiler as compiler
from pathlib import Path
from singlestoredb.connection import Connection as Connection
from typing import Any
from urllib.parse import ParseResult as ParseResult

class Backend(SupportsTempTables, SQLBackend, CanCreateDatabase, HasCurrentDatabase, PyArrowExampleLoader):
    name: str
    supports_create_or_replace: bool
    supports_temporary_tables: bool
    compiler = compiler
    @util.experimental
    def to_pyarrow_batches(self, expr, /, *, params=None, limit: int | str | None = None, chunk_size: int = 1000000, **_: Any): ...
    @property
    def con(self): ...
    @util.experimental
    @classmethod
    def from_connection(cls, con: Connection, /) -> Backend: ...
    @property
    def current_database(self) -> str: ...
    def create_database(self, name: str, force: bool = False) -> None: ...
    def drop_database(self, name: str, *, catalog: str | None = None, force: bool = False) -> None: ...
    def list_databases(self, *, like: str | None = None) -> list[str]: ...
    def list_tables(self, like: str | None = None, database: tuple[str, str] | str | None = None) -> list[str]: ...
    def get_schema(self, name: str, *, catalog: str | None = None, database: str | None = None) -> sch.Schema: ...
    @contextlib.contextmanager
    def begin(self) -> Generator[Any, None, None]: ...
    def execute(self, expr: ir.Expr, /, *, params: Mapping[ir.Scalar, Any] | None = None, limit: int | str | None = None, **kwargs: Any) -> pd.DataFrame | pd.Series | Any: ...
    def create_table(self, name: str, /, obj: ir.Table | pd.DataFrame | pa.Table | pl.DataFrame | pl.LazyFrame | None = None, *, schema: sch.SchemaLike | None = None, database: str | None = None, temp: bool = False, overwrite: bool = False) -> ir.Table: ...
    def drop_table(self, name: str, /, *, database: str | None = None, force: bool = False) -> None: ...
    def read_csv(self, path: str | Path, /, *, table_name: str | None = None, **kwargs: Any) -> ir.Table: ...
    def raw_sql(self, query: str | sg.Expression, **kwargs: Any) -> Any: ...
    @property
    def version(self) -> str: ...
    def do_connect(self, host: str | None = None, user: str | None = None, password: str | None = None, port: int | None = None, database: str | None = None, driver: str | None = None, autocommit: bool = True, local_infile: bool = True, **kwargs) -> None: ...
    def rename_table(self, old_name: str, new_name: str) -> None: ...

def connect(host: str | None = None, user: str | None = None, password: str | None = None, port: int | None = None, database: str | None = None, driver: str | None = None, autocommit: bool = True, local_infile: bool = True, **kwargs: Any) -> Backend: ...
