from typing import Generic, TypeVar
T_co = TypeVar("T_co", covariant=True)
class _Fam(Generic[T_co]): ...
class Value: ...
class NumericValue(Value, _Fam[float]): ...
class IntegerValue(NumericValue, _Fam[int]): ...
class FloatingValue(NumericValue): ...
class BooleanValue(NumericValue, _Fam[bool]): ...
class StringValue(Value, _Fam[str]): ...
class Column(Value): ...
class NumericColumn(Column, NumericValue): ...
class IntegerColumn(NumericColumn, IntegerValue): ...
class FloatingColumn(NumericColumn, FloatingValue): ...
